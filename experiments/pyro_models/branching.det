(* Wood et al. (2014), Program 5.3: Branching.

   The recursive Fibonacci computation, Poisson prior, branch-local
   Poisson draw, and observation are unchanged from the published
   benchmark.

   We replace the original query predict(r) with a posterior-predictive
   expectation query: draw a replicate from the same observation model. *)

(* Original model: *)
let fib = rec fib n =>
  if n < 1 then 1
  else if n < 2 then 1
  else fib (n - 1) + fib (n - 2)
in

let r = poisson[G](4) in

let l =
  if 4 < r then 6
  else
    let q = poisson[G](4) in
    fib (3 * r) + q
in

let _ = observe_poisson(6, l) in

(* Added query: *)
let y_rep = poisson[E](l) in
y_rep