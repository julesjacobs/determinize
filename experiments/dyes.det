(* Box & Tiao (1973), Bayesian Inference in Statistical Analysis,
   chapter 5, dyestuff example: posterior (5.2.14)/(5.2.22).
   https://doi.org/10.1002/9781118033197.ch5
   This is an explicit sampler for the reference-prior posterior in the book,
   NOT the BUGS Gamma(0.001,0.001) prior model.
   Within variance w and total mean-square variance v=w+5*b have independent
   inverse-chi-square posterior proposals, constrained by v>w.
   Degrees of freedom: within 24, between 5. Sum of squares: 58830, 56357.5.
   Data group means: 1505,1528,1564,1498,1600,1470; grand mean 1527.5.
   Original target model: y_ij ~ N(theta+a_i,w), a_i ~ N(0,b).
   Query adaptation: posterior expected yield theta+a_1 in the first batch.
   The conditional mean draw and the batch draw are both eliminable.
   Sampling distributions in .det use Gaussian variance and Gamma rate.
   Constants and derivation are recorded in hierarchical.md. *)
let draw_variances = rec draw_variances unused =>
  let w = 1 / gamma[G](12, 58830 / 2) in
  let v = 1 / gamma[G](2.5, 56357.5 / 2) in
  if w < v then (w, v) else draw_variances ()
in
let variances = draw_variances () in
let w = fst variances in
let v = snd variances in
let b = (v - w) / 5 in
let theta = gauss[E](1527.5, v / 30) in
gauss[E]((w / v) * theta + (5 * b / v) * 1505, b * w / v)
