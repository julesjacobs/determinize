(* George, Makov & Smith (1993), Conjugate Likelihood Distributions,
   Scandinavian Journal of Statistics 20, 147-156, pump-failure example.
   https://www.jstor.org/stable/4616270
   Model/data supplied in the task; source audit in hierarchical.md.
   alpha ~ Exp(1), beta ~ Gamma(0.1,1), theta_i ~ Gamma(alpha,beta),
   x_i ~ Poisson(t_i*theta_i). Gamma convention: SHAPE,RATE.
   This is a faithful rejection encoding, NOT the paper's Gibbs algorithm.
   Equality of integer observations is two <= comparisons. No likelihood
   normalization constants are dropped and no hyperparameter is fixed.
   After evidence, reconstruct theta_1 from its exact conditional posterior;
   this final draw is E. Query: posterior mean failure rate of pump 1.
   WARNING: prior rejection on all ten counts is extremely inefficient.
   Compilation is useful; this is not yet an efficient measurement baseline. *)
let alpha = exponential[G](1) in
let beta_rate = gamma[G](0.1, 1) in
let observations =
  (94.3, 5) :: (15.7, 1) :: (62.9, 5) :: (126, 14) :: (5.24, 3) ::
  (31.4, 19) :: (1.05, 1) :: (1.05, 1) :: (2.1, 4) :: (10.5, 22) :: []
in
let condition = rec condition rows =>
  match rows with [] => () | row :: rest =>
    let rate = gamma[G](alpha, beta_rate) in
    let count = poisson[G](fst row * rate) in
    let expected = snd row in
    let _ = observe(count <= expected) in
    let _ = observe(expected <= count) in
    condition rest
in
let _ = condition observations in
gamma[E](alpha + 5, beta_rate + 94.3)
