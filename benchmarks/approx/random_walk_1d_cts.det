(* From POLAR / MORA:

v = 0
x = 0
while true:
    v = Uniform(0,1)
    x = x + v {7/10} x - v
end

A flip(1/2) loop guard gives almost-sure termination while retaining
infinitely many reachable states after determinization.

*)

let v = 0 in
let x = 0 in
let loop = rec loop v => fun x =>
  if flip(1/2) then
    let v = uniform(0, 1) in
    let x =
      if flip(0.9) then
        x + v
      else
        x - v
    in
    loop v x
  else
    x
in

loop v x
