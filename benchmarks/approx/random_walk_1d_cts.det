(* From POLAR / MORA:

v = 0
x = 0
while true:
    v = Uniform(0,1)
    x = x + v {7/10} x - v
end

Partially determinizable but fully discrete after determinization with infinite state.

*)

let v = 0 in
let x = 0 in
let steps = 10 in

let loop = rec loop i => fun v => fun x =>
  if i < steps then
    let v = uniform(0, 1) in
    let x =
      if flip(0.9) then
        x + v
      else
        x - v
    in
    loop (i + 1) v x
  else
    x
in

loop 0 v x
