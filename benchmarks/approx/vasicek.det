(* From: Distribution Estimation for Probabilistic Loops https://arxiv.org/pdf/2205.07639#page=3.

a:= 0.5
b:= 0.2
σ:= 0.2
w:= 0
r:= 2
while true do
w:= Normal(0,1)
r:= (1−a)r+ ab+ σw
end while 

Fully determinizable but infinite state (deterministic) after determinization.
*)

let a = 0.5 in
let b = 0.2 in
let sigma = 0.8 in
let w = 0 in
let r = 2 in
let steps = 10 in

let loop = rec loop i => fun w => fun r =>
  if i < steps then
    let w = gauss(0, 1) in
    let r = (1 - a) * r + a * b + sigma * w in
    loop (i + 1) w r
  else
    r
in

loop 0 w r