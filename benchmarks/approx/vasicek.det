(* From: Distribution Estimation for Probabilistic Loops https://arxiv.org/pdf/2205.07639#page=3.

a:= 0.5
b:= 0.2
σ:= 0.2
w:= 0
r:= 2
while true do
w:= Normal(0,1)
r:= (1−a)r+ ab+ σw
end while 

A flip(1/2) loop guard gives almost-sure termination while retaining
infinitely many reachable states after determinization. The stopping
coins remain random when the Gaussian draws become their means.
*)

let a = 0.5 in
let b = 0.2 in
let sigma = 0.8 in
let w = 0 in
let r = 2 in
let loop = rec loop w => fun r =>
  if flip(1/2) then
    let w = gauss(0, 1) in
    let r = (1 - a) * r + a * b + sigma * w in
    loop w r
  else
    r
in

loop w r
