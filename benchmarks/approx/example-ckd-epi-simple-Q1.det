let logScr = uniform[G](-0.6, 0.6) in
let age = uniform(30, 80) in
let isFemale = uniform[G](0, 1) in
let isAA = uniform[G](0, 0.55) in
let f = 4.94 in
let f =
  if 0.5 <= isFemale then
    let k = -0.357 in
    (if logScr <= k then
       f - 0.329 * (logScr - k)
     else
       f - 1.209 * (logScr - k))
    + 0.017
  else
    let k = -0.105 in
    if logScr <= k then
      f - 0.411 * (logScr - k)
    else
      f - 1.209 * (logScr - k)
in
let f = if 0.5 <= isAA then f + 0.148 else f in
let logScrErr = logScr + uniform[G](-0.1, 0.1) in
let ageErr = age + uniform(-1, 1) in
let flip1 = uniform[G](0, 1) in
let isFemaleErr =
  if flip1 <= 0.01 then 1 - isFemale else isFemale
in
let flip2 = uniform[G](0, 1) in
let isAAErr =
  if flip2 <= 0.01 then 1 - isAA else isAA
in
let f1 = 4.94 in
let f1 =
  if 0.5 <= isFemaleErr then
    let k = -0.357 in
    (if logScrErr <= k then
       f1 - 0.329 * (logScrErr - k)
     else
       f1 - 1.209 * (logScrErr - k))
    + 0.017
  else
    let k = -0.105 in
    if logScr <= k then
      f1 - 0.411 * (logScrErr - k)
    else
      f1 - 1.209 * (logScrErr - k)
in
let f1 = if 0.5 <= isAAErr then f1 + 0.148 else f1 in
if f1 <= 4.4 then
  if 4.6 <= f then 0 else 1
else
  1
