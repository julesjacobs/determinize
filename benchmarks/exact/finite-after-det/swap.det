(* From Chakarov & Sriram (SAS 2014)

Original file contents:

x = 0 {1/2} 5
y = 4 {1/2} 7
while true:
    unif1 = Uniform(-1,1)
    unif2 = Uniform(-2,2)
    x, y = y + unif1, x + unif2
end

Fully determinizable; finite state after determinization.
*)

let x = 5 * bernoulli(0.5) in
let y = 4 + 3 * bernoulli(0.5) in
let loop = rec loop x => fun y =>
  let unif1 = uniform(-1, 1) in
  let unif2 = uniform(-2, 2) in
  loop (y + unif1) (x + unif2)
in
loop x y
