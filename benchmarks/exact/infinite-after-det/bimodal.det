(* From POLAR

Original file contents:

x = 0
xlow = 0
xup = 0
while true:
    d = Bernoulli(1/3)
    if d == 0:
        step = Normal(3/4, 1)
        xlow = xlow - step
        x = xlow
    else:
        step = Normal(3/4, 1)
        xup = xup + step
        x = xup
    end
end

Partially determinizable but fully discrete after determinization; infinite state after determinization.
*)

let loop = rec loop x => fun xlow => fun xup =>
  let d = bernoulli(1/3) in
  if d < 1 then
    let step = gauss(3/4, 1) in
    let xlow = xlow - step in
    loop xlow xlow xup
  else
    let step = gauss(3/4, 1) in
    let xup = xup + step in
    loop xup xlow xup
in
loop 0 0 0
