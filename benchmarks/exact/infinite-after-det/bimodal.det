(* From POLAR

Original file contents:

x = 0
xlow = 0
xup = 0
while true:
    d = Bernoulli(1/3)
    if d == 0:
        step = Normal(3/4, 1)
        xlow = xlow - step
        x = xlow
    else:
        step = Normal(3/4, 1)
        xup = xup + step
        x = xup
    end
end

Partially determinizable but fully discrete after determinization; infinite state after determinization.
*)

(* Query E[x_1] *)

let steps = 1 in
let loop = rec loop i => fun x => fun xlow => fun xup =>
  if i < steps then
    let d = bernoulli(1/3) in
    if d < 1 then
      let step = gauss(3/4, 4) in
      let xlow = xlow - step in
      loop (i + 1) xlow xlow xup
    else
      let step = gauss(3/4, 4) in
      let xup = xup + step in
      loop (i + 1) xup xlow xup
  else
    x
in
loop 0 0 0 0
