(* FROM: benchmarks/exact/asym-random-walk_variant.det, the asymmetric random walk of the
   GuBPI benchmarks (Zaiser et al.), without its soft conditioning *)

let f = rec f x =>
  if flip(0.5) then
    uniform(-1, 1)
  else if 2 <= x then
    uniform(-1, 0) + f 0
  else
    uniform(0, 1) + f (x + 1)
in

f 0
